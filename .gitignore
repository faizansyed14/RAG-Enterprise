# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Env files with real secrets
.env*
!.env*.example

# Local self-signed TLS cert for dev.yml's nginx (generated by openssl, not
# a real cert -- see infra/nginx/dev-certs' role in .env.dev's TLS_CERT_DIR)
infra/nginx/dev-certs/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tree engine local storage (dev, outside Docker) and other local data
backend/.rag-data/
backend/.rag-engine/

# Local data folders. The folders themselves stay in git (a .gitkeep in each, so Docker can bind-mount them), their contents never do:
#   sources/ = test files the connectors read (test corpus, uploads);  models/ = downloaded ONNX model files (scripts/get-models.sh)
sources/*
!sources/.gitkeep
models/*
!models/.gitkeep

# Local reference / corpus files (not for git)
Reference/
reference/

# Build artifacts
dist/
build/
*.log

# Windows/Cygwin crash dumps
*.stackdump
