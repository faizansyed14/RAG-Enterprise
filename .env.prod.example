# Copy to .env.prod and fill in. NEVER commit the real file (it is git-ignored).
# The backend refuses to start with ENVIRONMENT=prod if a required value is weak or still a default.
# Everything not listed here has a sensible default: the full list is docs/CONFIGURATION.md.

# ---- Read by docker compose itself ----
PUBLIC_URL=https://rag.example.com
STORAGE_PUBLIC_URL=https://my-bucket.s3.us-east-1.amazonaws.com
TLS_CERT_DIR=/etc/letsencrypt/live/rag.example.com
POSTGRES_PASSWORD=generate-a-long-random-password
# Where the data lives on the host. Point these at the big disk (see docs/DEPLOY_EC2.md). Leave unset for Docker-managed volumes.
# PGDATA_DIR=/data/postgres
# QDRANT_DATA_DIR=/data/qdrant
# RAG_DATA_DIR=/data/rag

# ---- Sign-in ----
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=generate-at-least-32-random-characters-here-please
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-passphrase-12+
CORS_ORIGINS=https://rag.example.com
TRUSTED_PROXY_HOPS=1

# ---- Databases (one Postgres, one Qdrant: the search index and the diagram vectors share this Qdrant) ----
POSTGRES_DSN=postgresql://rag:generate-a-long-random-password@postgres:5432/rag_engine
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=generate-a-long-random-key

# ---- File storage: S3. Private bucket. ----
# On EC2, leave both keys empty and give the instance an IAM role with read/write/delete on the bucket.
# Elsewhere (or another S3-compatible store: also set S3_ENDPOINT_URL), use an IAM user limited to this bucket.
S3_BUCKET=my-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Language models (answers, section trees, vision) ----
OPENROUTER_API_KEY=sk-or-replace-me
RAG_INDEX_MODEL=openai/gpt-4o-mini
RAG_CHAT_MODEL=openai/gpt-5-mini
MODEL_VISION=anthropic/claude-haiku-5.5
MODEL_EMBEDDING=openai/text-embedding-3-small
MODEL_EMBEDDING_DIMENSION=1536

# ---- Original files ----
# true : files that come from a source are also copied into object storage (MinIO / S3) so they can be previewed from there.
# false: the copy is NOT kept. Only the extracted pages (Postgres) and the search index (Qdrant) are stored. A citation shows the
#        stored text of the cited page and, for SharePoint / OneDrive, a link that opens the file at its source. Files uploaded
#        through the screen are always stored (there is no other copy of them). Recommended at terabyte scale.
# Applies to files ingested after a restart of the backend and worker; files already stored keep their copy.
STORE_ORIGINALS=false

# ---- Page images of scanned / drawing PDFs ----
# false: the vision model still reads each scanned page; what it read (text + a description of what the page shows) is what gets
#        searched. No page image or separate image index is stored, and chat shows no extra pictures: a citation opens the cited
#        page of the PDF itself. (Default.)
# true : the older behaviour: every such page is also saved as a PNG with its own vector, and chat shows the best-matching images.
STORE_DIAGRAMS=false

# ---- Scanned PDFs, photos and picture-only pages ----
# A PDF is read by the ordinary local reader first. Pages it cannot read (no text layer, or mostly one large picture with little text)
# are then read by the vision model (MODEL_VISION), and image files (png / jpg / tif / bmp / webp) are accepted. A page that already has
# its text is never sent, even with a picture on it. Needs OPENROUTER_API_KEY. About one model call per page sent.
# false: such pages are not read: a PDF with no text is skipped (needs_ocr), image files are refused.
SCALE_DOCPARSE_MODE=off
SCALE_OCR_ENABLED=true
# SCALE_VISION_MAX_PAGES=40          # per document; the rest keep their own text
# SCALE_VISION_MIN_CHARS=60          # fewer characters than this = no usable text layer
# SCALE_VISION_IMAGE_RATIO=0.35      # images cover this share of a page that has little text = send it
# SCALE_VISION_MAX_TEXT_CHARS=1500   # a page with more text than this is never sent

# ---- Section trees ----
# true : a tree (section outline + a model-written summary per section) is built for every UI upload AND every file that arrives from
#        a source (SharePoint, OneDrive, folders ...). Costs model calls on RAG_INDEX_MODEL for each file.
# false: no tree and no model call at ingest, even if OPENROUTER_API_KEY is set. Pages are still stored and chunked, so search and
#        answers work (the chat agent finds pages by keyword search). Recommended at terabyte scale.
# Takes effect for files ingested after a restart of the backend and worker. Existing documents keep what they have.
TREE_GENERATION=false
# Only with true: source files shorter than this many pages get no tree (0 or 1 = every file).
# SCALE_AUTO_PROMOTE_MIN_PAGES=0

# ---- Search index and workers ----
# Local models (no API calls): bash scripts/get-models.sh puts them in ./models, mounted at /models.
# The defaults already point at them (bge-small-en-v1.5-int8 for meaning, ms-marco MiniLM for reranking).
# A different embedding model creates a NEW index; the old one keeps answering until the new one has caught up (docs/scale/CAPACITY.md).
SCALE_WORKER_CONCURRENCY=8
# Embedding model: BGE-small, 8-bit (about 2x faster to embed, same accuracy). Changing any of these three creates a NEW search index
# that the worker fills by itself from the stored pages. BGE wants an instruction in front of each QUESTION (not in front of documents);
# without it vector-only search was 4-7 points worse in the measurements. Leave the prefix empty for any other model.
SCALE_EMBED_MODEL=bge-small-en-v1.5-int8
SCALE_ONNX_MODEL_DIR=/models/bge-small-en-v1.5-int8
SCALE_EMBED_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
# Multi-terabyte corpora: chunk text stays in Postgres only, vectors are quantised and kept on disk (docs/scale/CAPACITY.md).
SCALE_STORE_CHUNK_TEXT=false
SCALE_QUANTIZE_INT8=true
SCALE_ON_DISK_VECTORS=true
SCALE_SPARSE_ON_DISK=true
SCALE_QDRANT_ON_DISK_PAYLOAD=true
# Folder on the host with files for the "folder" source (mounted read-only at /mnt/sources):
# SCALE_SOURCE_DIR=/srv/rag-sources

# ---- SharePoint / OneDrive: everything comes from here; the Connectors screen only has Connect and Disconnect ----
# Microsoft Entra app registration (read-only application permissions). Restart the backend and worker after changing these.
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_SITES: empty = every site the app can see
# SHAREPOINT_SITES=https://contoso.sharepoint.com/sites/Finance,https://contoso.sharepoint.com/sites/Legal
# SHAREPOINT_LIBRARIES: optional, comma-separated; empty = all
# SHAREPOINT_LIBRARIES=
# SHAREPOINT_ACCESS: source = each file keeps its Microsoft 365 sharing | everyone
# SHAREPOINT_ACCESS=source
# ONEDRIVE_TENANT_ID=
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_CLIENT_SECRET=
# ONEDRIVE_USERS: or ONEDRIVE_ALL_USERS=true for every member account
# ONEDRIVE_USERS=ana@contoso.com,bo@contoso.com
# ONEDRIVE_ACCESS=source

# ---- Other source secrets: a connection names the variable; the value lives only here ----
# Windows file shares (a read-only service account)
# SMB_PASSWORD=
# Others: GITHUB_TOKEN, JIRA_API_TOKEN, SLACK_BOT_TOKEN, NOTION_TOKEN ... (docs/scale/CONNECTORS.md)
